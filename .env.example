# ---------------------------------------------------------------------------
# Copy to .env.local and fill in. NEVER commit real values.
# ---------------------------------------------------------------------------

# Site
NEXT_PUBLIC_SITE_URL=https://nayanazimabad.vercel.app

# Optional: Postgres (Supabase) — only needed if you switch the content layer
# from the static TypeScript data files to Prisma. See prisma/schema.prisma.
# DATABASE_URL=postgres://user:pass@host:5432/nayanazimabad

# Contact form destination. Leave unset to run in "log only" mode (default, safe).
# CONTACT_EMAIL_TO=info@nayanazimabad.com
# RESEND_API_KEY=re_xxx

# Optional LLM-assisted content tooling (see llm.txt)
# OPENAI_API_KEY=sk-...
